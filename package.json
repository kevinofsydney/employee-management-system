{
  "name": "translator-roster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite.mjs dev",
    "build": "tsc --noEmit && node scripts/vite.mjs build",
    "preview": "node scripts/vite.mjs preview",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply translator-roster --local",
    "db:migrate:remote": "wrangler d1 migrations apply translator-roster --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "jose": "^6.2.12",
    "luxon": "^3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/luxon": "^3.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
